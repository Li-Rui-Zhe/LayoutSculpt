{
  "name": "layoutsculpt",
  "description": "支持 Codex 与 API 接入的开源 AI 空间设计工作台，涵盖户型识别、交互式 3D 编辑、建筑构件与灯具、家具与墙地面 DIY、素材管理及 GLB 导出。",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "launch": "node scripts/backend.mjs launch",
    "start": "node scripts/backend.mjs start",
    "dev": "vite --config frontend/vite.config.js",
    "dev:api": "node scripts/backend.mjs dev",
    "dev:all": "node scripts/backend.mjs all",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js --host 127.0.0.1",
    "test:backend": "node scripts/backend.mjs test",
    "test:frontend": "node --test frontend/tests/*.test.js",
    "test:prelaunch": "node scripts/prelaunch.mjs",
    "test:visual": "node scripts/review/visual_review.mjs",
    "review:interactions": "node scripts/review/interaction_audit.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.9"
  }
}
