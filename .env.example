# 默认继承本机 Codex 的登录与模型配置；无需在项目内存储 API Key。
# CODEX_CMD=C:/path/to/codex.exe
# CODEX_MODEL=你的本地服务支持的模型名称
CODEX_EFFORT=medium
CODEX_TIMEOUT_SECONDS=600
# 自动检测 PATH、Windows 默认安装目录或项目 tools/blender 中的 Blender。
# 推荐固定 Blender 4.5.9 LTS；bpy 由 Blender 自带，无需 pip 安装。
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
BLENDER_TIMEOUT_SECONDS=180
JOB_CONCURRENCY=2
# STUDIO_DATA_DIR=D:/habitat-data
