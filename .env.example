# 默认继承本机 Codex；也可在页面「AI 接入」中配置 DeepSeek。
# 不要在此填写 API 密钥；接入页会将密钥加密保存在被忽略的本地 data/ 中。
# CODEX_CMD=C:/path/to/codex.exe
# CODEX_MODEL=你的本地服务支持的模型名称
CODEX_EFFORT=medium
CODEX_TIMEOUT_SECONDS=600
# 可选 AI 复核的等待上限；超时保留识别结构，进入人工核对。
AI_REVIEW_TIMEOUT_SECONDS=300
# 复用相同原图、模型、强度、提示和结构版本下已通过校验的阶段结果。
AI_CACHE_ENABLED=true
# 仅在离线修改家具源资产时需要 Blender；普通户型生成不使用。
# BLENDER_PATH=C:/Program Files/Blender Foundation/Blender 4.5/blender.exe
MODEL_TIMEOUT_SECONDS=180
JOB_CONCURRENCY=2
# STUDIO_DATA_DIR=D:/habitat-data

# 墙面/地板材质设计使用所选 AI 来源，无需额外图片服务。
